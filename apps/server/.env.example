PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/student_results
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=12h
# Use a DIFFERENT long random string from JWT_SECRET so student and admin tokens are separate.
STUDENT_JWT_SECRET=replace-this-with-a-different-long-random-string
STUDENT_JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Local seed password only. Change it before seeding anything that is not a demo.
SEED_STUDENT_PASSWORD=student123
# Number of trusted reverse proxy hops in front of the API (Nginx = 1).
TRUST_PROXY=1
# Temporary testing helper: set to true to turn off the one-click setup button on the login pages.
DISABLE_QUICK_SETUP=false
