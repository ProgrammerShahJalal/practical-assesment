# Copy this file to .env before running Docker Compose outside a local demo.
# Docker Compose reads .env from the project root for variable interpolation.

JWT_SECRET=replace-this-with-a-long-random-string
STUDENT_JWT_SECRET=replace-this-with-a-different-long-random-string
JWT_EXPIRES_IN=12h
STUDENT_JWT_EXPIRES_IN=12h

# Same origin is used because the image serves the built client and the API.
CLIENT_ORIGIN=http://localhost:4000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SEED_STUDENT_PASSWORD=student123

TRUST_PROXY=1
DISABLE_QUICK_SETUP=false
